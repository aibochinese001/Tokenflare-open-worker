# Local development variables — copy to `.dev.vars` (never commit).
# `wrangler dev` reads .dev.vars automatically. Real secrets go in
# `.dev.vars` locally and via `wrangler secret put` in production.

# --- Required ---
ADMIN_TOKEN=change-me-long-random-string

# --- Only if you enable OIDC SSO ---
# SESSION_SECRET=change-me-32-bytes-random
# OIDC_ISSUER=https://your-idp.example.com
# OIDC_CLIENT_ID=your-client-id
# ADMIN_EMAIL=you@example.com

# --- Optional: billing (credits) ---
# BILLING_ENABLED=1
# DEFAULT_PRICE_MICRO=500000
# DISCOUNT=0.1
# SIGNUP_BONUS_USD=100
# TRANSACTION_RETENTION_DAYS=90
# PENDING_ORDER_RETENTION_DAYS=30
# LOG_RETENTION_DAYS=30

# --- Optional: Stripe online top-up ---
# PUBLIC_BASE_URL=https://your-worker.example.com
# CURRENCY=usd
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Optional: branding ---
# BRAND_NAME=keypool
# SSO_LABEL=Sign in
# SSO_NOTE=Single sign-on.
